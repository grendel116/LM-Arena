# LM-Arena Environment Configurations

# Active language model engine backend: 'opensource' (scaffolding)
RUNNER_BACKEND=opensource

# --- SERVER HOST & PORT CONFIGURATION ---
# The IP address the main server should bind to. Use '0.0.0.0' to listen on all interfaces.
HOST=0.0.0.0
PORT=5000

# --- LOCAL OPEN-SOURCE BACKEND SETUP (Local LLM / llama-server) ---
LOCAL_SERVER_URL=http://127.0.0.1:1234/v1/chat/completions
LOCAL_MODEL_NAME=meta-llama-3-8b-instruct

# Local LLM Context:
# LOCAL_CONTEXT: Override default model context length (optional, e.g. 8192).
LOCAL_CONTEXT=8192

# LOCAL_GPU_LAYERS: Number of layers to offload to the GPU (e.g. 99 to offload all layers, or lower like 32 for partial offload).
LOCAL_GPU_LAYERS=99
LOCAL_CACHE_TYPE_K=q8_0
LOCAL_CACHE_TYPE_V=q8_0

# LOCAL_FLASH_ATTN: Enable Flash Attention for speed/memory optimization (true/false).
LOCAL_FLASH_ATTN=true

# LOCAL_NO_MMAP: Disable memory mapping. Helpful for slow mechanical hard drives (true/false).
LOCAL_NO_MMAP=false
LOCAL_GPU_TYPE=AMD

# Prefill batching control:
LOCAL_BATCH_SIZE=2048
LOCAL_UBATCH_SIZE=512

# --- IMAGE GENERATION SETUP (ComfyUI) ---
COMFYUI_SERVER_URL=http://127.0.0.1:8188
COMFYUI_DIR=
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_VAE=sdxl_vae.safetensors
COMFYUI_ARGS=--lowvram

# PyTorch Memory Allocation Options
PYTORCH_HIP_ALLOC_CONF=expandable_segments:True,max_split_size_mb:512
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:512

# --- SECURITY & AUTHENTICATION SETUP ---
AUTH_USER=
AUTH_PASS=

# --- HTTPS / SSL CONFIGURATION ---
USE_HTTPS=false
SSL_CERT=
SSL_KEY=
