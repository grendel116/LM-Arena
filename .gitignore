# Python env and cache
.venv*
ComfyUI/
ComfyUI_windows_portable*/
__pycache__/
*.pyc

# Local Config (contains credentials and settings)
.env
variables/project_settings.json

# Temporary files
backups/
scratch/
reports/
certs/
core/comfy_engine/temp/

# Ignore all runtime and user variables except code dependencies, template examples, and default profile
variables/*
!variables/__init__.py
!variables/settings.py
!variables/banned_words.json
!variables/saves/
variables/saves/*
!variables/saves/eternal_champion.json

# Ignore all companion profiles under core/followers except the default Arena guide
core/followers/*
!core/followers/ria_silmane/

# Ignore user-generated dynamic program sessions, databases, custom generated portraits, media, and memories
core/followers/*/sessions/
core/followers/*/portraits/*
!core/followers/*/portraits/profile.png
core/followers/*/media/
core/followers/*/uploads/
core/followers/*/databank.db
core/followers/*/databank.json
core/followers/*/journals.json
core/followers/*/memories.json
core/followers/*/quest_log.json
core/followers/*/lorebooks/
core/embeddings.pkl
temp_uploads/
static/uploads/
static/media/
static/generated/
uploads/
media/


# Local model weights
models/

# TTS Speech Model weights and synthesized audio cache
core/skills/speech_generation/speech_model/*.onnx
core/skills/speech_generation/speech_model/*.bin
core/skills/speech_generation/speech_cache/

# Runtime logs
*.log
comfy_server.log

# Workflow Configs
ImageWorkflow.json
VideoWorkflow.json

# Local Binaries
utils/llama-bin/